rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /appointments/{appointmentId} {
      // Sadece giriş yapmış admin okuyabilir (isim/telefon gibi kişisel veri içerir).
      allow read: if request.auth != null;

      // Herkes randevu oluşturabilir, ama sadece "pending" olarak.
      // Giriş yapmış admin ayrıca bir saati manuel "blocked" olarak
      // işaretleyebilir, ya da telefonla gelen bir randevuyu doğrudan
      // "confirmed" (onaylı) olarak kaydedebilir (isim/telefon/hizmet
      // zorunlu, çünkü gerçek bir müşteri kaydıdır).
      allow create: if
        request.resource.data.date is string &&
        request.resource.data.time is string &&
        (
          (
            request.auth != null &&
            request.resource.data.status == 'blocked'
          ) ||
          (
            request.auth != null &&
            request.resource.data.status == 'confirmed' &&
            request.resource.data.name is string && request.resource.data.name.size() > 0 &&
            request.resource.data.phone is string && request.resource.data.phone.size() > 0 &&
            request.resource.data['service'] is string
          ) ||
          (
            request.resource.data.status == 'pending' &&
            request.resource.data.name is string && request.resource.data.name.size() > 0 &&
            request.resource.data.phone is string && request.resource.data.phone.size() > 0 &&
            request.resource.data['service'] is string
          )
        );

      // Sadece admin onay/red/iptal güncellemesi yapabilir.
      allow update: if request.auth != null;

      allow delete: if false;
    }

    // Kişisel veri içermeyen, herkese açık "dolu saat" göstergesi.
    // Randevu widget'ı bunu okuyarak dolu/kapalı saatleri gösterir; gerçek
    // çakışma koruması yine appointments koleksiyonundaki transaction'da
    // yapılır, bu koleksiyon sadece görüntüleme amaçlıdır.
    match /slotStatus/{slotId} {
      allow read: if true;

      // "Dolu" işareti herkes tarafından yazılabilir (randevu alma anında,
      // her zaman taken=true). Giriş yapmış admin ayrıca taken=false yazarak
      // statik kapalı bir saati bu tarih için "açık" olarak işaretleyebilir.
      allow create: if
        request.resource.data.date is string &&
        request.resource.data.time is string &&
        (
          request.auth != null ||
          request.resource.data.taken == true
        );

      // Bir saati tekrar "boş" yapmak (serbest bırakmak) sadece admin
      // işlemidir (onay/red/iptal/engel kaldırma).
      allow update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
