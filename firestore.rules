rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /appointments/{appointmentId} {
      // Sadece giriş yapmış admin okuyabilir (isim/telefon gibi kişisel veri içerir).
      allow read: if request.auth != null;

      // Herkes randevu oluşturabilir, ama sadece "pending" olarak.
      // Giriş yapmış admin ayrıca bir saati manuel "blocked" olarak da
      // işaretleyebilir (isim/telefon zorunlu değil).
      allow create: if
        request.resource.data.date is string &&
        request.resource.data.time is string &&
        (
          (
            request.auth != null &&
            request.resource.data.status == 'blocked'
          ) ||
          (
            request.resource.data.status == 'pending' &&
            request.resource.data.name is string && request.resource.data.name.size() > 0 &&
            request.resource.data.phone is string && request.resource.data.phone.size() > 0 &&
            request.resource.data['service'] is string
          )
        );

      // Sadece admin onay/red/iptal güncellemesi yapabilir.
      allow update: if request.auth != null;

      allow delete: if false;
    }

    // Kişisel veri içermeyen, herkese açık "dolu saat" göstergesi.
    match /slotStatus/{slotId} {
      allow read: if true;

      allow create: if
        request.resource.data.date is string &&
        request.resource.data.time is string &&
        (
          request.auth != null ||
          request.resource.data.taken == true
        );

      allow update, delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}